# =============================================================================
# Azure Local Load Tools - .gitignore
# =============================================================================

# Runtime logs (generated during test execution; created on demand)
logs/
tools/*/logs/

# Runtime state files (generated during automation runs)
state/run-state.json
state/fault-lock.json
state/history/

# Generated reports (PDF, DOCX, XLSX output)
reports/**/*.pdf
reports/**/*.docx
reports/**/*.xlsx
reports/**/*.html
reports/**/run-*/
!reports/templates/

# CI-generated diagram exports
docs/images/*.png
docs/images/*.svg

# Credential files (never commit secrets)
config/credentials/*.secret
config/credentials/*.key
config/credentials/*.pem
config/credentials/.env

# User-specific config (actual values — never commit)
config/variables.yml

# Generated solution config files (built from variables.yml)
# Uncomment the next line if you want these regenerated every time:
# config/variables/solutions/*.json

# PowerShell module artifacts
*.nupkg

# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Ansible artifacts
*.retry

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl

# IDE / Editor
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~

# OS artifacts
Thumbs.db
.DS_Store
Desktop.ini

# Build outputs
build/
dist/
output/
site/

# Node (if any doc tooling uses it)
node_modules/
package-lock.json

# Ruby (asciidoctor)
.bundle/
vendor/bundle/
Gemfile.lock


# Claude Code local settings (logs and machine-local overrides only)
.claude/logs/
.claude/settings.local.json
